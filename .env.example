# Copy to `.env` and fill in. `.env` is git-ignored.

# Required. The application will not start without it.
# Generate with:  openssl rand -base64 64
JWT_SECRET=

# Required on first startup outside the dev profile. Remove after the first
# administrator is created; store the password in a secret manager.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional — these have working defaults for local use.
DB_NAME=kpi
DB_USERNAME=kpi_user
DB_PASSWORD=kpi_pass

# Browser origins allowed to call the API. Credentials are sent with requests,
# so this cannot be "*".
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080
